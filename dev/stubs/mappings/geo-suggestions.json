{
  "name": "geo-suggestions",
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPath": "/geo/v1/suggestions",
    "queryParameters": {
      "city": {
        "equalTo": "Санкт-Петербург"
      },
      "addressLine": {
        "equalTo": "Кронверкский пр., 49"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "candidates": [
        {
          "location": {
            "lat": 59.9571,
            "lon": 30.3083
          },
          "timezone": "Europe/Moscow"
        }
      ]
    }
  }
}
