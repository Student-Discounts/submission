# Compose reads .env; host Gradle processes need `set -a; source .env; set +a`.
# These credentials and stub URLs are LOCAL DEVELOPMENT ONLY.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081
SD_SUBMISSION_DB_URL=jdbc:postgresql://localhost:5433/submission
SD_SUBMISSION_DB_USER=submission
SD_SUBMISSION_DB_PASSWORD=submission
SD_SUBMISSION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SD_SUBMISSION_KAFKA_GROUP_ID=submission-workflow-v1
SD_SUBMISSION_AUTH_ISSUER=http://localhost:8080
SD_SUBMISSION_AUTH_JWK_SET_URI=http://localhost:8080/.well-known/jwks.json
SD_SUBMISSION_CATALOG_BASE_URL=http://localhost:8090
SD_SUBMISSION_MEDIA_BASE_URL=http://localhost:8090
SD_SUBMISSION_GEO_BASE_URL=http://localhost:8090
SD_SUBMISSION_ORGANIZATIONS_BASE_URL=http://localhost:8090
SD_SUBMISSION_CORS_ALLOWED_ORIGINS=http://localhost:5173
SD_SUBMISSION_MAX_BODY_BYTES=262144
SD_SUBMISSION_REQUESTS_PER_MINUTE=120
SD_SUBMISSION_VALIDATION_ENABLED=true
SD_SUBMISSION_OUTBOX_ENABLED=true
# Smoke-only optional real-auth credentials: never commit populated values.
SD_AUTH_BASE_URL=http://localhost:8080
