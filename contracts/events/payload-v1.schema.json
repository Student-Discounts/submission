{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:student-discounts:submission:payload:v1",
  "type": "object",
  "properties": {
    "place": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "addressLine": {
          "type": "string",
          "maxLength": 300
        },
        "categoryCode": {
          "type": "string",
          "maxLength": 50
        },
        "location": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "additionalProperties": false,
          "required": [
            "lat",
            "lon"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "city",
        "addressLine",
        "categoryCode"
      ]
    },
    "offers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "conditions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "discountType": {
            "enum": [
              "PERCENT",
              "FIXED_AMOUNT",
              "SPECIAL_PRICE",
              "FREE_ITEM",
              "OTHER"
            ],
            "default": "OTHER"
          },
          "discountValue": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 99999999.99,
            "multipleOf": 0.01
          },
          "source": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "WEBSITE",
                  "SOCIAL_MEDIA",
                  "ORGANIZATION",
                  "PERSONAL_VISIT",
                  "OTHER"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048,
                "pattern": "^https?://"
              },
              "note": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "additionalProperties": false
          },
          "validFrom": {
            "type": "string",
            "format": "date"
          },
          "validUntil": {
            "type": "string",
            "format": "date"
          },
          "schedule": {
            "type": "array",
            "maxItems": 28,
            "items": {
              "type": "object",
              "properties": {
                "dayOfWeek": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "timeFrom": {
                  "type": "string",
                  "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "timeUntil": {
                  "type": "string",
                  "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                }
              },
              "additionalProperties": false,
              "required": [
                "dayOfWeek",
                "timeFrom",
                "timeUntil"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "conditions",
          "discountType"
        ]
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "mediaAssetId": {
            "type": "string",
            "format": "uuid"
          },
          "purpose": {
            "enum": [
              "PHOTO",
              "PROOF"
            ]
          },
          "offerIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "additionalProperties": false,
        "required": [
          "mediaAssetId",
          "purpose"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "place",
    "offers"
  ],
  "description": "Normalized immutable full snapshot. CHANGE has exactly one offer. Source type plus URL/note OR matching PROOF is required per offer. PERCENT is 1–100; FREE_ITEM/OTHER omit discountValue. Coordinates optional but paired; resolved timezone is version metadata, never a payload field. Inclusive validUntil is checked in resolved zone (UTC without coordinates). Adjacent intervals allowed; overlaps/midnight crossing forbidden. Client cannot supply place/offer IDs; service derives target IDs."
}
