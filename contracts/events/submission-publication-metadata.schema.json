{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:student-discounts:catalog:publication-metadata:v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "SubmissionPublicationMetadata"
    },
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "const": "submission"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    },
    "data": {
      "type": "object",
      "properties": {
        "submissionId": {
          "type": "string",
          "format": "uuid"
        },
        "versionId": {
          "type": "string",
          "format": "uuid"
        },
        "versionNo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "type": {
          "enum": [
            "NEW_PLACE",
            "NEW_OFFER",
            "CHANGE"
          ]
        },
        "resolvedTimezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "basePlaceRowVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "submissionId",
        "versionId",
        "versionNo",
        "type",
        "resolvedTimezone",
        "basePlaceRowVersion"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "producer",
    "occurredAt",
    "correlationId",
    "data"
  ],
  "additionalProperties": false
}
