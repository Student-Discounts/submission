{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:student-discounts:submission:workflow:v1",
  "title": "Trusted workflow input — submission.workflow.v1",
  "description": "Kafka key is submissionId, except MediaAssetChecked uses mediaAssetId. All authorized topic writers are trusted for the entire workflow: producer string is not authentication. Production TLS/SASL and ACLs prohibit end-user writes. Exact reviewed tuple/current rowVersion required; moderation actor cannot equal author. SubmissionApproved only reaches APPROVED, never publication.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "producer",
    "occurredAt",
    "correlationId",
    "data"
  ],
