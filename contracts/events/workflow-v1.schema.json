          "type": "object",
          "properties": {
            "submissionId": {
              "type": "string",
              "format": "uuid"
            },
            "versionId": {
              "type": "string",
              "format": "uuid"
            },
            "versionNo": {
              "type": "integer",
              "minimum": 1
            },
            "expectedRowVersion": {
              "type": "integer",
              "minimum": 0
            },
            "actorId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false,
          "required": [
            "submissionId",
            "versionId",
            "versionNo",
            "expectedRowVersion",
            "actorId"
          ]
        }
      },
